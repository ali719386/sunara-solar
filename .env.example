# Copy to .env.local (or set in Vercel > Project > Settings > Environment Variables).
# Any value left empty is hidden on the site.

# WhatsApp number in international format, digits only, e.g. 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=923057707321

# Public site URL without a trailing slash, used in structured data, e.g. https://sunara.pk
NEXT_PUBLIC_SITE_URL=

# Social profile URLs shown in the footer
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Server only (never prefix with NEXT_PUBLIC_). Google Gemini key from https://aistudio.google.com/apikey
# Powers the "AI Solar Advice" text in the home page savings calculator (/api/solar-advice)
# and the SUNARA Assistant chatbot (/api/chat). Without it, both fall back to built-in answers.
# On Vercel: Project > Settings > Environment Variables.
GEMINI_API_KEY=

# Optional: Gemini model to use (default gemini-3.8-flash).
GEMINI_MODEL=

# Free NLR key, only for re-running scripts/build-state-sun.mjs (the site itself never calls NLR):
# https://developer.nlr.gov/signup/
NLR_API_KEY=
