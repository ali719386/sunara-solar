# Copy to .env.local (or set in Vercel > Project > Settings > Environment Variables).
# Any value left empty is hidden on the site.

# WhatsApp number in international format, digits only, e.g. 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public site URL without a trailing slash, used in structured data, e.g. https://sunara.pk
NEXT_PUBLIC_SITE_URL=

# Social profile URLs shown in the footer
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
